{
  "name": "dsh-ptc-plus",
  "version": "0.0.0-development",
  "description": "A session-bound agent-native REPL for DeepSeek Harness Code Mode.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./omnipotent-preset": "./omnipotent-preset.js",
    "./preset-roster": "./preset-roster.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "omnipotent-preset.js",
    "preset-roster.js",
    "presets",
    "internal",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@babel/code-frame": "^7.29.7",
    "acorn": "^8.15.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/dsh-agent-presets": "0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-tool-presentation": "0.1.0-rc.7",
    "@deepseek-ai/dsh-permission-presets": "0.1.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/dsh-agent-presets": "0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-tool-presentation": "0.1.0-rc.7",
    "@deepseek-ai/dsh-permission-presets": "0.1.0-rc.7"
  },
  "scripts": {
    "coverage": "node --test --experimental-test-module-mocks --experimental-test-coverage --test-concurrency=1 --test-coverage-include=\"index.js\" --test-coverage-include=\"internal/*.js\" --test-coverage-lines=100 --test-coverage-branches=95 --test-coverage-functions=100",
    "check": "node --check index.js && node --check preset-roster.js && node --check omnipotent-preset.js && npm run coverage"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ptc",
    "code-mode",
    "repl"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
